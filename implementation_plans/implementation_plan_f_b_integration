@app.post("/upload")
async def upload_files(files: List[UploadFile] = File(...)):
    saved = []
    for f in files:
        dest = UPLOAD_DIR / f.filename
        async with aiofiles.open(dest, "wb") as out:
            await out.write(await f.read())
        saved.append(str(dest))
    return {"paths": saved}
```

