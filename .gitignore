# ============================================================
# VAJRA — Comprehensive .gitignore
# ============================================================

# ============================================================
# PYTHON BACKEND
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
build/
dist/
.eggs/

# Virtual Environments
.venv/
venv/
env/
ENV/

# uv lock (auto-generated, not needed in repo)
uv.lock

# Env / Secrets
.env
.env.local
configs/.env
*.secret

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Testing & Coverage
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# ============================================================
# FRONTEND (React / Node / Vite)
# ============================================================
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Vite build output
frontend/.vite/
dist/
build/

# ============================================================
# DATA & GENERATED FILES
# ============================================================
data/sample_scanned_reports/*
data/sample_images/*
data/sample_sops/*
# Keep placeholder files
!data/sample_scanned_reports/.gitkeep
!data/sample_images/.gitkeep
!data/sample_sops/.gitkeep

outputs/
scratch/
tmp/
test-data/

# ============================================================
# BINARY / MEDIA FILES
# ============================================================
*.pdf
*.jpg
*.jpeg
*.png
*.tif
*.tiff
*.bmp
*.docx
*.xlsx
*.pptx

# AI Model weights — never commit
*.gguf
*.bin
*.safetensors
models/*.gguf

# ============================================================
# VECTOR DB (ChromaDB)
# ============================================================
knowledge_base/chroma_db/
*.chroma

# ============================================================
# LOGS & TEMP
# ============================================================
*.log
*.out

# ============================================================
# OS FILES
# ============================================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# IDE & EDITOR
# ============================================================
.vscode/
.idea/
*.swp
*.swo
*.suo
