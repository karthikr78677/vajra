# =============================================
# Vajra — Local Environment Configuration
# =============================================
# Copy this file to .env and fill in your paths.
# DO NOT commit .env to GitHub (it's in .gitignore).

# --- Tesseract OCR ---
# Path to your local Tesseract executable.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Ollama ---
# Base URL for the local Ollama server (default port 11434).
OLLAMA_BASE_URL=http://localhost:11434

# --- ChromaDB (Knowledge Base) ---
# Local folder where ChromaDB persists the vector database.
CHROMA_DB_PATH=knowledge_base/chroma_db
